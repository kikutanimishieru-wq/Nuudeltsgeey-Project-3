{
  "name": "nuudeltsgeey-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:smoke": "node scripts/smoke-check.cjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "predeploy": "npm run db:validate && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": { "seed": "node prisma/seed.cjs" }
}
