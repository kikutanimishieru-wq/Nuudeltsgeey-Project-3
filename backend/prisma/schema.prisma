generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  REFEREE
  ADMIN
  SUPER_ADMIN
}
enum AccountStatus {
  CREATED
  UNVERIFIED
  VERIFIED
  ACTIVE
  UNDER_REVIEW
  SUSPENDED
  BADGE_REVOKED
}
enum TournamentStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  CHECK_IN
  ROSTER_LOCKED
  LIVE
  COMPLETED
  ARCHIVED
}
enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
}
enum MatchStatus {
  PENDING
  READY
  LIVE
  AWAITING_CONFIRMATION
  DISPUTED
  VERIFIED
  LOCKED
}
enum MatchResult {
  WIN
  LOSS
  FORFEIT
}
enum ConfirmationDecision {
  CONFIRMED
  DISPUTED
}
enum IncidentStatus {
  REPORTED
  UNDER_REVIEW
  VIOLATION_ESTABLISHED
  CLOSED
}
enum PenaltyLevel {
  NONE
  WARNING
  COMPETITIVE_PENALTY
  TOURNAMENT_REMOVAL
  SUSPENSION
  BADGE_REVOCATION
}
enum RatingTransactionType {
  PLACEMENT
  PARTICIPATION
  MATCH_RESULT
  REVERSAL
  ADMIN_ADJUSTMENT
}
enum AchievementKind {
  FIRST_STEP
  FIRST_BLOOD
  VETERAN
  BATTLE_TESTED
  FIFTY_BATTLES
  STREAK_III
  STREAK_V
  FINALIST
  CHAMPION
  KHAN
}
enum VetoAction {
  BAN
  PICK
}
enum TournamentAwardKind {
  PARTICIPATION
  CHAMPION
  RUNNER_UP
  SEMIFINALIST
}

model IdentitySequence {
  id        String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

// Session core is source preparation only; no migration or activation performed.
enum SessionAuthenticationMethod {
  DISCORD
  LEGACY_PASSWORD
}

model AuthSession {
  idHash          String @id
  userId          String
  authGeneration  BigInt
  method          SessionAuthenticationMethod
  createdAt       DateTime @db.Timestamptz(3)
  authenticatedAt DateTime @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([idHash, userId, authGeneration])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  // CHECKs and immutability triggers require separately reviewed additive SQL.
}

model User {
  id                    String        @id @default(uuid())
  email                 String        @unique
  passwordHash          String
  authGeneration        BigInt        @default(0)
  authSessions          AuthSession[]
  role                  UserRole      @default(PLAYER)
  accountStatus         AccountStatus @default(CREATED)
  publicNmdId           String        @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  incidentParties       IncidentParty[]
  reviewAssignments     ReviewAssignment[] @relation("AssignedReviewer")
  reviewAssignmentsMade ReviewAssignment[] @relation("AssigningAdmin")
  externalIdentities    ExternalIdentity[]
  identityChallenges    IdentityChallenge[]
  identityGrants        IdentityLoginGrant[]
  lockedTournaments TournamentLockSnapshot[]
  latenessDecisions TournamentLatenessClaim[]
  hostedTournaments     Tournament[] @relation("TournamentHost")
  identity              PrivateIdentity?
  profile               PlayerProfile?
  auditEvents           AuditEvent[]
  incidentsReported     Incident[]    @relation("IncidentReporter")
  incidentsReviewed     Incident[]    @relation("IncidentReviewer")
  suspensionsIssued     Suspension[] @relation("SuspensionIssuer")
  suspensionsFor        Suspension[] @relation("SuspendedUser")
  confirmations         ResultConfirmation[]
  correctionsRequested  MatchCorrection[] @relation("CorrectionRequester")
  correctionsApproved   MatchCorrection[] @relation("CorrectionApprover")
  rulesAcceptances      RulesAcceptance[]
}

model PrivateIdentity {
  id                 String   @id @default(uuid())
  userId             String   @unique
  legalName          String
  dateOfBirth        DateTime?
  phone              String?
  verificationNotes  String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PlayerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  nickname           String
  csRole             String?
  identityRole       String?
  avatarUrl          String?
  currentNr          Int      @default(1000)
  floor              Int      @default(1)
  verifiedMatches    Int      @default(0)
  wins               Int      @default(0)
  losses             Int      @default(0)
  currentStreak      Int      @default(0)
  bestStreak         Int      @default(0)
  tournamentsPlayed  Int      @default(0)
  tournamentsWon     Int      @default(0)
  currentTeamId      String?
  homeCafeId         String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTeam        Team?    @relation("CurrentTeam", fields: [currentTeamId], references: [id])
  homeCafe           Cafe?    @relation(fields: [homeCafeId], references: [id])
  captainedTeams     Team[]   @relation("TeamCaptain")
  teamMemberships    TeamMembership[]
  ratingTransactions RatingTransaction[]
  matchSnapshots     PlayerNrSnapshot[]
  achievements       PlayerAchievement[]
  teamInvitations    TeamInvitation[]
  soloRegistrations TournamentRegistration[] @relation("SoloEntrant")
  latenessClaims TournamentLatenessClaim[]
  tournamentRosters  TournamentRosterMember[]
  matchParticipants  MatchParticipant[]
  tournamentAwards   TournamentAward[]
  @@unique([nickname])
  @@index([currentNr])
}

model Cafe {
  id          String          @id @default(uuid())
  name        String
  district    String?
  players     PlayerProfile[]
  teams       Team[]
  tournaments Tournament[]
  createdAt   DateTime        @default(now())
}

model Team {
  id              String            @id @default(uuid())
  name            String            @unique
  tag             String?
  cafeId          String?
  captainId       String?
  cafe            Cafe?             @relation(fields: [cafeId], references: [id])
  captain         PlayerProfile?    @relation("TeamCaptain", fields: [captainId], references: [id])
  currentPlayers  PlayerProfile[]   @relation("CurrentTeam")
  memberships     TeamMembership[]
  registrations   TournamentRegistration[]
  matchesA        Match[]           @relation("TeamA")
  matchesB        Match[]           @relation("TeamB")
  invitations     TeamInvitation[]
  matchParticipants MatchParticipant[]
  mapVetoes       MapVeto[]
  createdAt       DateTime          @default(now())
}

model TeamMembership {
  id         String        @id @default(uuid())
  teamId     String
  playerId   String
  isStarter  Boolean       @default(true)
  joinedAt   DateTime      @default(now())
  leftAt     DateTime?
  team       Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player     PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([teamId, playerId, joinedAt])
  @@index([playerId, leftAt])
}

model TeamInvitation {
  id          String        @id @default(uuid())
  teamId      String
  playerId    String
  status      String        @default("PENDING")
  invitedAt   DateTime      @default(now())
  respondedAt DateTime?
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player      PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([teamId, playerId, status])
}

model Tournament {
  hostUserId      String?
  host            User? @relation("TournamentHost", fields: [hostUserId], references: [id], onDelete: Restrict)
  configurationPolicy String?
  entryFee        Int?
  id              String                    @id @default(uuid())
  name            String
  venue           String
  game            String                    @default("Counter-Strike 2")
  format          String
  style           String
  capacity        Int
  teamSize        Int                     @default(5)
  startersPerTeam Int                     @default(5)
  maxSubstitutes  Int                     @default(1)
  rulesVersion    String                    @default("1.0")
  status          TournamentStatus          @default(DRAFT)
  startsAt        DateTime?
  cafeId          String?
  cafe            Cafe?                     @relation(fields: [cafeId], references: [id])
  registrationPolicy TournamentRegistrationPolicy?
  lockSnapshot TournamentLockSnapshot?
  latenessClaims TournamentLatenessClaim[]
  latenessRequests TournamentLatenessRequest[]
  registrations   TournamentRegistration[]
  matches         Match[]
  incidents       Incident[]
  auditEvents     AuditEvent[]
  awards          TournamentAward[]
  rulesAcceptances RulesAcceptance[]
  @@index([hostUserId, status])
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
}

model TournamentRegistration {
  id            String             @id @default(uuid())
  tournamentId  String
  teamId        String?
  soloPlayerId  String?
  soloPlayer PlayerProfile? @relation("SoloEntrant", fields: [soloPlayerId], references: [id], onDelete: Restrict)
  withdrawnAt   DateTime? @db.Timestamptz(3)
  disqualifiedAt DateTime? @db.Timestamptz(3)
  disqualificationReason String?
  status        RegistrationStatus @default(PENDING)
  checkedInAt   DateTime?
  checkInStatus String             @default("NOT_CHECKED_IN")
  checkInNote   String?
  rosterLockedAt DateTime?
  tournament    Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team          Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roster        TournamentRosterMember[]
  @@unique([tournamentId, soloPlayerId])
  @@unique([tournamentId, teamId])
}

model TournamentRosterMember {
  id             String                 @id @default(uuid())
  registrationId String
  playerId       String
  isStarter      Boolean                @default(true)
  acceptedAt     DateTime?
  checkedInAt    DateTime? @db.Timestamptz(3)
  checkInRuleVersion String?
  attendanceVerifiedAt DateTime? @db.Timestamptz(3)
  attendanceEvidenceRef String?
  registration   TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  player         PlayerProfile          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([registrationId, playerId])
}

model Match {
  id              String               @id @default(uuid())
  tournamentId    String
  round           String
  bracketOrder    Int
  teamAId         String?
  teamBId         String?
  status          MatchStatus          @default(PENDING)
  result          MatchResult?
  winnerTeamId    String?
  teamAScore      Int?
  teamBScore      Int?
  submittedAt     DateTime?
  lockedAt        DateTime?
  tournament      Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamA           Team?                @relation("TeamA", fields: [teamAId], references: [id])
  teamB           Team?                @relation("TeamB", fields: [teamBId], references: [id])
  confirmations   ResultConfirmation[]
  snapshots       PlayerNrSnapshot[]
  latenessClaims TournamentLatenessClaim[]
  latenessRequests TournamentLatenessRequest[]
  rankingEvent    RankingEvent?
  corrections     MatchCorrection[]
  incidents       Incident[]
  auditEvents     AuditEvent[]
  participants    MatchParticipant[]
  vetoes          MapVeto[]
  @@unique([tournamentId, round, bracketOrder])
}

model MatchParticipant {
  id          String        @id @default(uuid())
  matchId     String
  teamId      String
  playerId    String
  isSubstitute Boolean      @default(false)
  match       Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player      PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([matchId, playerId])
  @@index([matchId, teamId])
}

model MapVeto {
  id        String    @id @default(uuid())
  matchId   String
  sequence  Int
  teamId    String
  action    VetoAction
  mapName   String
  lockedAt  DateTime?
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@unique([matchId, sequence])
}

model ResultConfirmation {
  id          String               @id @default(uuid())
  matchId     String
  userId      String
  teamId      String
  decision    ConfirmationDecision
  reason      String?
  createdAt   DateTime             @default(now())
  match       Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([matchId, teamId])
}

model PlayerNrSnapshot {
  id        String        @id @default(uuid())
  matchId   String
  playerId  String
  nr        Int
  match     Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([matchId, playerId])
}

model RankingEvent {
  id           String              @id @default(uuid())
  matchId      String              @unique
  createdAt    DateTime            @default(now())
  match        Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  transactions RatingTransaction[]
}

model RatingTransaction {
  id             String                @id @default(uuid())
  rankingEventId String?
  playerId       String
  type           RatingTransactionType
  delta          Int
  beforeNr       Int
  afterNr        Int
  note           String?
  createdAt      DateTime              @default(now())
  rankingEvent   RankingEvent?         @relation(fields: [rankingEventId], references: [id])
  player         PlayerProfile         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@index([playerId, createdAt])
}

model Achievement {
  id          String              @id @default(uuid())
  kind        AchievementKind     @unique
  name        String
  description String
  players     PlayerAchievement[]
}

model PlayerAchievement {
  id            String        @id @default(uuid())
  playerId      String
  achievementId String
  awardedAt     DateTime      @default(now())
  player        PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  achievement   Achievement   @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  @@unique([playerId, achievementId])
}

model TournamentAward {
  id           String              @id @default(uuid())
  tournamentId String
  playerId     String
  kind         TournamentAwardKind
  nrDelta      Int
  awardedAt    DateTime            @default(now())
  tournament   Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player       PlayerProfile       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([tournamentId, playerId, kind])
}

model RulesAcceptance {
  id           String      @id @default(uuid())
  userId       String
  tournamentId String?
  rulesVersion String
  acceptedAt   DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@unique([userId, tournamentId, rulesVersion])
}

model Incident {
  id             String         @id @default(uuid())
  tournamentId   String
  matchId        String?
  reporterId     String?
  reviewerId     String?
  category       String
  description    String
  status         IncidentStatus @default(REPORTED)
  penalty        PenaltyLevel   @default(NONE)
  evidenceRef    String?
  parties        IncidentParty[]
  assignments    ReviewAssignment[]
  playerResponse String?
  decidedAt      DateTime?
  tournament     Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match          Match?         @relation(fields: [matchId], references: [id])
  reporter       User?          @relation("IncidentReporter", fields: [reporterId], references: [id])
  reviewer       User?          @relation("IncidentReviewer", fields: [reviewerId], references: [id])
  @@index([tournamentId, status])
}

model Suspension {
  id          String   @id @default(uuid())
  userId      String
  issuedById  String
  reason      String
  startsAt    DateTime
  endsAt      DateTime?
  active      Boolean  @default(true)
  user        User     @relation("SuspendedUser", fields: [userId], references: [id])
  issuedBy    User     @relation("SuspensionIssuer", fields: [issuedById], references: [id])
}

model MatchCorrection {
  id            String           @id @default(uuid())
  matchId       String
  requestedById String
  approvedById  String?
  reason        String
  previousData  Json
  correctedData  Json
  status        String           @default("PENDING")
  requestedAt   DateTime         @default(now())
  approvedAt    DateTime?
  match         Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  requestedBy   User             @relation("CorrectionRequester", fields: [requestedById], references: [id])
  approvedBy    User?            @relation("CorrectionApprover", fields: [approvedById], references: [id])
}

model AuditEvent {
  id           String      @id @default(uuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  tournamentId String?
  matchId      String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  actor        User?       @relation(fields: [actorId], references: [id])
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  match        Match?      @relation(fields: [matchId], references: [id])
  @@index([entityType, entityId, createdAt])
}

// Provider possession is verified server-side, never by an administrative ACTIVE flag.
enum IdentityProvider {
  STEAM
  DISCORD
}

model ExternalIdentity {
  id                String @id @default(uuid())
  userId            String
  provider          IdentityProvider
  providerAccountId String
  verifiedAt        DateTime
  revokedAt         DateTime?
  administrativeHoldAt DateTime?
  revocationKind    String?
  user              User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model IdentityChallenge {
  tokenHash   String @id
  provider    IdentityProvider
  intent      String
  browserHash String
  reauthenticatedAt DateTime?
  userId      String?
  user        User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  expiresAt   DateTime
  consumedAt  DateTime?
  @@index([expiresAt])
}

model IdentityLoginGrant {
  // Nullable for historical grants; no default/backfill that could upgrade authority.
  authGeneration BigInt?
  createdAt      DateTime? @db.Timestamptz(3)
  tokenHash   String @id
  userId      String
  provider    IdentityProvider
  browserHash String
  expiresAt   DateTime
  consumedAt  DateTime?
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([expiresAt])
}

model SteamAssertionNonce {
  nonceHash String @id
  expiresAt DateTime
}

model RateLimitBucket {
  key       String @id
  count     Int
  resetsAt  DateTime
  @@index([resetsAt])
}

// Explicit parties and independently attested assignment close gaps in legacy cases.
model IncidentParty {
  incidentId String
  userId     String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  user       User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([incidentId, userId])
}

model ReviewAssignment {
  incidentId String
  reviewerId String
  assignedById String
  attestedAt DateTime @default(now())
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  reviewer User @relation("AssignedReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  assignedBy User @relation("AssigningAdmin", fields: [assignedById], references: [id], onDelete: Restrict)
  @@id([incidentId, reviewerId])
}

// Approval references are governance inputs, not host-editable policies.
model TournamentRegistrationPolicy {
  tournamentId String @id
  registrationClosesAt DateTime @db.Timestamptz(3)
  deadlineApprovalRef String
  rulesVersion String
  attendancePolicyRef String?
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
}

model TournamentLatenessClaim {
  id String @id @default(uuid())
  tournamentId String
  playerId String
  player PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Restrict)
  matchId String?
  match Match? @relation(fields: [matchId], references: [id], onDelete: Restrict)
  scheduledStart DateTime @db.Timestamptz(3)
  protectedDeadline DateTime @db.Timestamptz(3)
  reason String
  evidenceRef String
  policyVersion String?
  requests TournamentLatenessRequest[]
  decision String @default("PENDING_GOVERNANCE")
  decisionById String?
  decisionBy User? @relation(fields: [decisionById], references: [id], onDelete: Restrict)
  decisionAt DateTime? @db.Timestamptz(3)
  usedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  @@unique([tournamentId, playerId])
}

model TournamentLockSnapshot {
  tournamentId String @id
  lockedAt DateTime @default(now()) @db.Timestamptz(3)
  lockedById String
  lockedBy User @relation(fields: [lockedById], references: [id], onDelete: Restrict)
  rulesVersion String
  activePlayerCount Int
  classification String
  snapshot Json
  digest String
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
}

// Requests are separate from the one-per-tournament incident, preserving expired
// attempts without consuming or resetting that shared incident.
model TournamentLatenessRequest {
  id String @id @default(uuid())
  claimId String
  claim TournamentLatenessClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  tournamentId String
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  matchId String?
  match Match? @relation(fields: [matchId], references: [id], onDelete: Restrict)
  scheduledStart DateTime @db.Timestamptz(3)
  protectedDeadline DateTime @db.Timestamptz(3)
  reason String
  policyVersion String
  status String @default("REQUESTED")
  requestedAt DateTime @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  expiredAt DateTime? @db.Timestamptz(3)
  @@index([tournamentId, status])
}
